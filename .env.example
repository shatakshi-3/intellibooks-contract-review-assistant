# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon PostgreSQL / Database Connection (with pgvector enabled)
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Vercel Blob (Private Storage)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_placeholder

# OpenRouter AI
OPENROUTER_API_KEY=sk-or-v1-placeholder

# Application Configuration & OpenRouter Models
# For development/testing, free models such as "openrouter/free" or "meta-llama/llama-3.3-70b-instruct:free" are supported.
AI_REVIEW_MODEL=openrouter/free
AI_CHAT_MODEL=openrouter/free
# Embedding model: defaults to 1536-dimensional embeddings (compatible with pgvector HNSW index limit of 2,000)
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
PROMPT_VERSION=v1
LOG_LEVEL=debug
NODE_ENV=development
