{
  "name": "intellibooks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "eval": "tsx tests/evaluation/run-evaluation.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.7",
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/blob": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.77.0",
    "mammoth": "^1.13.0",
    "next": "16.4.6",
    "pdf-parse": "^2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "svix": "^2.11.0",
    "tailwind-merge": "^3.7.1",
    "workflow": "^5.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vitest": "^3.0.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "cbor-extract",
      "esbuild",
      "@napi-rs/canvas"
    ]
  }
}
